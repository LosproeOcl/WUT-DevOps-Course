# Full deployment: CPU-only torch + transformers + all models
# (TF-IDF + BERT + RoBERTa aspects, TF-IDF + RoBERTa rating).
#
# The slim Dockerfile (Dockerfile) ships only the TF-IDF models; this variant
# includes the large BERT/RoBERTa weights (~1.2 GB) and the deep-learning stack
# so every model is available. Build with a permissive .dockerignore that keeps
# models/bert, models/roberta and models/rating_bert in the context.

FROM node:20-alpine AS frontend
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /app

RUN python -m pip install --no-cache-dir --upgrade pip
RUN python -m pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

COPY requirements-full.txt ./
RUN python -m pip install --no-cache-dir -r requirements-full.txt

COPY app/ ./app/
COPY ml/ ./ml/
COPY models/ ./models/
COPY data/demo.csv ./data/demo.csv
COPY --from=frontend /app/dist ./frontend/dist

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
